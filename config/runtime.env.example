# Copy selected entries to ~/.config/frankateleop/runtime.env when a machine
# needs persistent overrides. Explicit shell environment variables take priority.
# Do not store passwords in this file.

FRANKA_LEFT_HOST=192.168.100.67
FRANKA_LEFT_SSH=muka@192.168.100.67
FRANKA_LEFT_REPO=/home/muka/frankateleop

BI_ARM_RIGHT_HOST=192.168.1.131
BI_ARM_RIGHT_SSH=pnp@192.168.1.131
BI_ARM_RIGHT_REPO=/home/pnp/frankateleop

BI_ARM_LEFT_ZMQ_PORT=6002
BI_ARM_RIGHT_REMOTE_ZMQ_PORT=6001
BI_ARM_RIGHT_LOCAL_ZMQ_PORT=16001
BI_ARM_RIGHT_LOCAL_GRIPPER_PORT=15053

# Treat these three Xpra entries as one mapping when overriding the left host.
FRANKA_XPRA_HOST=muka@192.168.100.67
FRANKA_XPRA_REPO=/home/muka/frankateleop
FRANKA_XPRA_SSH_SOCKET=/tmp/codex-franka-67.sock
